# LOVEW Style — environment template. Copy to .env.local (never commit .env.local).
# In production these are set as Vercel env vars.

# --- App ---
NEXT_PUBLIC_SITE_URL=https://style.lovewstudio.com
NEXT_PUBLIC_DEFAULT_LOCALE=id

# --- Supabase (Singapore region) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (images) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (transactional email) ---
RESEND_API_KEY=

# --- Fonnte (WhatsApp) ---
FONNTE_TOKEN=

# --- Payments ---
# Tier 0 launch uses ManualTransferProvider (bank transfer / personal QRIS).
# MidtransProvider is added at M3 — leave these blank until then.
PAYMENT_PROVIDER=manual
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# --- Manual-mode bank + QRIS payment details (shown on the payment page) ---
BANK_NAME=BCA
BANK_ACCOUNT_NO=0000000000
BANK_ACCOUNT_HOLDER=LOVEW Studio
LOVEW_WHATSAPP=6281234567890
# A static QRIS PNG can be dropped at public/qris.png — no env needed.

# --- Cron protection ---
# Generate any long random string. Vercel cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# --- Monitoring ---
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
